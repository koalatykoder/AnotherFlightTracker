import { Telemetry, FlightData, WifiSettings } from "ui/telemetry.slint";
import { LineEdit, Button } from "std-widgets.slint";
export { Telemetry, FlightData, WifiSettings }

export component MainWindow inherits Window {
    width: 1024px;
    height: 600px;
    title: "Flight Tracker";
    background: #081226;

    // 1. Full Screen Background
    Image {
        source: @image-url("background.jpg");
        width: 100%;
        height: 100%;
        image-fit: fill;
    }

    // 2. Top Bar: Header & Weather/Settings
    HorizontalLayout {
        x: 32px;
        y: 20px;
        width: 960px;
        height: 40px;
        alignment: space-between;

        Text {
            text: Telemetry.has-active-flight ? "A PLANE IS NEARBY!" : "Searching...";
            color: #ffffff;
            font-size: 26px;
            font-weight: 900;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 16px;
            alignment: center;

            if Telemetry.active-flight.temperature-text != "": HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text {
                    text: "☁ " + Telemetry.active-flight.temperature-text;
                    color: #e0f2fe;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            // Gear Icon Button
            Rectangle {
                width: 36px;
                height: 36px;
                background: touch-settings.has-hover ? #ffffff30 : #ffffff15;
                border-radius: 18px;

                Text {
                    text: "⚙";
                    font-size: 18px;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touch-settings := TouchArea {
                    clicked => {
                        WifiSettings.is-open = !WifiSettings.is-open;
                    }
                }
            }
        }
    }

    // 3. Center Dashboard Overlay Container
    if Telemetry.has-active-flight: VerticalLayout {
        x: 162px;
        y: 250px;
        width: 700px;
        spacing: 10px;
        alignment: start;

        // --- Airline Logo Badge & Callsign Banner ---
        HorizontalLayout {
            alignment: start;
            spacing: 12px;

            Rectangle {
                background: #0f1d38e6;
                border-color: #38bdf880;
                border-width: 1.5px;
                border-radius: 10px;
                height: 52px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 18px;
                    spacing: 12px;
                    alignment: center;

                    Image {
                        source: Telemetry.active-flight.airline-logo;
                        height: 32px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: Telemetry.active-flight.callsign + (Telemetry.active-flight.airline-name != "" ? " · " + Telemetry.active-flight.airline-name : "");
                            color: #93c5fd;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }

        // --- Aircraft Type Label ---
        if Telemetry.active-flight.aircraft-type != "": Text {
            text: Telemetry.active-flight.aircraft-type;
            color: #facc15;
            font-size: 16px;
            font-weight: 800;
            horizontal-alignment: center;
            width: 100%;
        }

        // --- Route Card ---
        Rectangle {
            height: 110px;
            background: #0b172be6;
            border-color: #1e3a5f;
            border-width: 2px;
            border-radius: 14px;

            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 20px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    width: 160px;
                    Text { 
                        text: Telemetry.active-flight.origin-code; 
                        color: #ffffff; 
                        font-size: 34px; 
                        font-weight: 900; 
                        horizontal-alignment: center;
                    }
                    Text { 
                        text: Telemetry.active-flight.origin-city; 
                        color: #94a3b8; 
                        font-size: 11px; 
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;

                    Rectangle {
                        y: 14px;
                        width: 100%;
                        height: 2px;
                        background: #ffffff30;
                    }

                    Text {
                        x: Telemetry.route-line-width;
                        y: 2px;
                        text: "✈";
                        color: #facc15;
                        font-size: 22px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    width: 160px;
                    Text { 
                        text: Telemetry.active-flight.dest-code; 
                        color: #ffffff; 
                        font-size: 34px; 
                        font-weight: 900; 
                        horizontal-alignment: center;
                    }
                    Text { 
                        text: Telemetry.active-flight.dest-city; 
                        color: #94a3b8; 
                        font-size: 11px; 
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // --- Metrics Card (Updated Altitude SVG Graphic) ---
        Rectangle {
            height: 75px;
            background: #0b172be6;
            border-color: #1e3a5f;
            border-width: 2px;
            border-radius: 14px;

            HorizontalLayout {
                padding-left: 40px;
                padding-right: 40px;
                spacing: 0px;

                // Altitude Section with SVG Symbol
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    alignment: center;

                    Image {
                        source: @image-url("assets/ui/altitude_symbol.svg");
                        width: 64px;
                        height: 64px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "ALTITUDE"; color: #38bdf8; font-size: 11px; font-weight: 800; }
                        Text { text: Telemetry.active-flight.altitude; color: #ffffff; font-size: 22px; font-weight: 800; }
                    }
                }

                Rectangle { width: 1px; background: #ffffff20; height: 45px; }

                // Speed Section
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "⏲";
                        font-size: 26px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "SPEED"; color: #4ade80; font-size: 11px; font-weight: 800; }
                        Text { text: Telemetry.active-flight.speed; color: #ffffff; font-size: 22px; font-weight: 800; }
                    }
                }
            }
        }
    }

    // 4. Night Mode Toggle
    Rectangle {
        x: 952px;
        y: 532px;
        width: 44px;
        height: 44px;
        background: #0b172be6;
        border-color: #38bdf880;
        border-width: 1.5px;
        border-radius: 22px;

        Text {
            text: "🌙";
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 5. Wi-Fi Settings Overlay
    if WifiSettings.is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b0;

        TouchArea {
            clicked => {
                WifiSettings.is-open = false;
            }
        }

        Rectangle {
            width: 460px;
            height: 350px;
            x: (1024px - 460px) / 2;
            y: (600px - 350px) / 2;
            background: #0f172a;
            border-color: #38bdf8;
            border-width: 2px;
            border-radius: 16px;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text { text: "Wi-Fi Settings"; color: #ffffff; font-size: 18px; font-weight: 700; }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "SSID:"; color: #38bdf8; font-size: 13px; }
                    ssid-input := LineEdit { text: WifiSettings.wifi-ssid; height: 38px; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Password:"; color: #38bdf8; font-size: 13px; }
                    password-input := LineEdit { text: WifiSettings.wifi-password; input-type: password; height: 38px; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { WifiSettings.is-open = false; } }
                    Button { 
                        text: "Save & Connect"; 
                        primary: true; 
                        clicked => {
                            WifiSettings.wifi-updated(ssid-input.text, password-input.text);
                            WifiSettings.is-open = false;
                        }
                    }
                }
            }
        }
    }
}